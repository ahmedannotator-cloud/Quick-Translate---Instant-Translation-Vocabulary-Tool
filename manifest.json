{
  "manifest_version": 3,
  "name": "Quick Translate",
  "version": "1.2",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "128": "icon.png" }
  }
}